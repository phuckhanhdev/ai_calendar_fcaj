# =========================================================================
# AWS ENVIRONMENT CONFIGURATION - AI DESTINY CALENDAR
# =========================================================================

# 1. Database Configuration (AWS RDS MySQL hoặc Local MySQL)
# - Thay thế endpoint, username, password thực tế của database instance
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=lifesync_ai

# 2. AWS Credentials & Bedrock AI Configuration (Quyền gọi Bedrock)
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Google Gemini (Dự phòng/Thay thế Bedrock)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# 3. Email & OTP Configuration (AWS SES via SMTP interface hoặc Google SMTP)
# AWS SES Config:
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=your_ses_smtp_username
# SMTP_PASS=your_ses_smtp_password
# SMTP_FROM=your-verified-sender-email@domain.com

# Google SMTP Config (Dùng để test):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_gmail@gmail.com

# 4. Security Configuration
# - Khoá bí mật dùng để ký token JWT cho phiên đăng nhập của người dùng
JWT_SECRET=your_jwt_secret_key_here
